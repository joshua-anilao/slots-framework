{
  "name": "slots-framework",
  "private": true,
  "version": "0.1.0",
  "description": "Slot game framework: shared TypeScript math engine, game logic and simulator for HTML prototypes and Cocos production games.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "prototype-web"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sim": "tsx packages/simulator/src/cli.ts",
    "check": "npm run typecheck && npm test",
    "proto": "npm run dev -w @slots/prototype-web",
    "proto:build": "npm run build -w @slots/prototype-web"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=22.17"
  }
}
